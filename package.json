{
  "name": "@seriouslysean/openclaw-context-pacer",
  "version": "0.1.0",
  "private": true,
  "description": "OpenClaw plugin that paces agents that gather with tools: a status line on each gathering result, and optionally large results moved to files.",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "agents",
    "context"
  ],
  "homepage": "https://github.com/seriouslysean/openclaw-context-pacer#readme",
  "bugs": "https://github.com/seriouslysean/openclaw-context-pacer/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seriouslysean/openclaw-context-pacer.git"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.16"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-lines=80 --test-coverage-branches=85 --test-coverage-functions=80 'test/*.test.ts'"
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.3"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "openclaw": "2026.10.5",
    "oxlint": "1.89.0",
    "typescript": "7.0.2"
  },
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.10.3",
      "minGatewayVersion": "2026.10.3"
    },
    "build": {
      "openclawVersion": "2026.10.3",
      "pluginSdkVersion": "2026.10.3"
    }
  },
  "files": [
    "dist/",
    "src/",
    "openclaw.plugin.json"
  ]
}
